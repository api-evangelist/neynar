{
  "opencollection": "1.0.0",
  "info": {
    "name": "Neynar Action Message API",
    "version": "3.176.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Message",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Submit signed message",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.neynar.com/v1/submitMessage"
          },
          "docs": "Submit a message to the Farcaster network."
        },
        {
          "info": {
            "name": "Validate signed message",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.neynar.com/v1/validateMessage"
          },
          "docs": "Validate a message on the Farcaster network."
        }
      ]
    }
  ],
  "bundled": true
}