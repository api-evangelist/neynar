{
  "opencollection": "1.0.0",
  "info": {
    "name": "Neynar Action Topic API",
    "version": "3.176.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Topic",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch trending topics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.neynar.com/v2/farcaster/topic/trending/",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of topics to fetch."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Pagination cursor."
              }
            ]
          },
          "docs": "Returns a list of trending topics for casts."
        }
      ]
    }
  ],
  "bundled": true
}