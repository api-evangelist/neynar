{
  "opencollection": "1.0.0",
  "info": {
    "name": "Neynar Action Usernames API",
    "version": "3.176.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Usernames",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Proofs provided by an FID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.neynar.com/v1/userNameProofsByFid",
            "params": [
              {
                "name": "fid",
                "value": "616",
                "type": "query",
                "description": "The FID being requested"
              }
            ]
          },
          "docs": "Fetch proofs provided by a user."
        },
        {
          "info": {
            "name": "Proof for a username",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.neynar.com/v1/userNameProofByName",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "The Farcaster username or ENS address"
              }
            ]
          },
          "docs": "Fetch a proof for a username."
        }
      ]
    }
  ],
  "bundled": true
}