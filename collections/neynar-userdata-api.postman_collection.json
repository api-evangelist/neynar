      "item": [
        {
          "id": "ed172629-4a97-41ea-8b5d-3c46b62207bb",
          "name": "Fetch UserData for a FID",
          "request": {
            "name": "Fetch UserData for a FID",
            "description": {
              "content": "**Note:** one of two different response schemas is returned based on whether the caller provides the `user_data_type` parameter. If included, a single `UserDataAdd` message is returned (or a `not_found` error). If omitted, a paginated list of `UserDataAdd` messages is returned instead.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "userDataByFid"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "fid",
                  "value": "<integer>",
                  "description": "(Required) The FID that's being requested"
                },
                {
                  "disabled": false,
                  "key": "user_data_type",
                  "value": "USER_DATA_TYPE_PFP",
                  "description": "The type of user data, either as a numerical value or type string. If this is omitted, all user data for the FID is returned"
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "<integer>",
                  "description": "Maximum number of messages to return in a single response"
                },
                {
                  "disabled": false,
                  "key": "reverse",
                  "value": "<boolean>",
                  "description": "Reverse the sort order, returning latest messages first"
                },
                {
                  "disabled": false,
                  "key": "pageToken",
                  "value": "<string>",
                  "description": "The page token returned by the previous query, to fetch the next page. If this parameter is empty, fetch the first page"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
