          "name": "On cast",
          "request": {
            "name": "On cast",
            "description": {
              "content": "Retrieve all reactions (likes or recasts) on a specific cast in the Farcaster network. The cast is identified by its creator's FID and unique hash. This endpoint helps track engagement metrics and user interactions with specific content.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "reactionsByCast"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "target_fid",
                  "value": "<uint64>",
                  "description": "(Required) The FID of the cast's creator. Required to uniquely identify the cast that received the reactions. Must be used in conjunction with target_hash."
                },
                {
                  "disabled": false,
                  "key": "target_hash",
                  "value": "<string>",
                  "description": "(Required) The unique hash identifier of the cast that received the reactions. This is a 40-character hexadecimal string prefixed with '0x' that uniquely identifies the cast within the creator's posts. Must be used with target_fid."
                },
                {
                  "disabled": false,
                  "key": "reaction_type",
                  "value": "Like",
                  "description": "(Required) "
                },
                {
